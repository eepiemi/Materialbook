<?xml version="1.0" encoding="utf-8"?>
<!--
  Non-adaptive fallback for API 21-25 (adaptive icons need API 26+, see
  mipmap-anydpi-v26/ic_launcher.xml). "anydpi" without "-v26" is matched by
  any API level >= 21 that doesn't have a more specific qualifier, so devices
  on 26+ still resolve to the adaptive version automatically.

  Flattens the two-layer adaptive icon (background rect + foreground glyph)
  into one vector since there's no adaptive masking pre-Oreo anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108H0z"
        android:fillColor="@color/ic_launcher_background"/>
    <path
        android:pathData="M54,26L30,82L41,82Z M54,26L78,82L67,82Z M46.11,60L61.89,60L63.98,69L44.02,69Z"
        android:fillColor="@color/ic_launcher_foreground"/>
</vector>
